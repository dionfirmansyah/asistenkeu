# Salin file ini menjadi `.env.local` untuk pengembangan lokal.
# Untuk deploy di CI (GitHub Actions), isi dengan nama yang sama sebagai
# repository secrets: Settings → Secrets and variables → Actions → New repository secret.
#
# Catatan: nilai berawalan VITE_ dibundel ke JavaScript, sehingga tetap dapat
# dilihat siapa pun yang membuka aplikasi produksi.

# OAuth 2.0 Client ID Google (tipe "Web application"). Authorized JavaScript origins
# wajib memuat: http://localhost:5173 dan https://dionfirmansyah.github.io
VITE_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# ID folder root Google Drive tempat dokumen aplikasi tersimpan.
VITE_ROOT_FOLDER_ID=folder-id-di-drive
